          "code": "def preprocess_dataframes(dataframes):\n    processed = {}\n    for filename, df in dataframes.items():\n        if filename == 'sales_pipeline.csv':\n            df_copy = df.copy()\n            if all(col in df_copy.columns for col in ['revenue', 'discount_pct', 'units']):\n                df_copy['net_revenue_after_discount'] = df_copy['revenue'] * (1 - df_copy['discount_pct'] / 100)\n                df_copy['revenue_per_unit'] = df_copy['revenue'] / df_copy['units']\n            processed[filename] = df_copy\n        else:\n            processed[filename] = df.copy()\n    return processed",
