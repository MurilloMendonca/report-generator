# Created as .env.local by `sh scripts/local.sh init`. This is a local-only stack.
# Keep the generated secrets when restarting; stored provider keys need the same keyring.
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD
APP_ENCRYPTION_KEYS=v1:GENERATE_ENCRYPTION_KEY
APP_ENCRYPTION_ACTIVE_KEY=v1
LOCAL_PORT=8000

# Use the exact model ID installed in your server. The URL is reached from Docker.
# For LM Studio, use http://host.docker.internal:1234/v1 and its loaded model ID.
PDF_REPORT_LLM_ENDPOINTS='[{"id":"local","label":"Local LLM","base_url":"http://host.docker.internal:11434/v1","models":["llama3.1:8b"],"requires_api_key":false}]'
PDF_REPORT_LLM_TIMEOUT_SECONDS=180
